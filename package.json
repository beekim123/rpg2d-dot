{
  "name": "astra-rpg",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run godot:run",
    "build": "npm run godot:export:web",
    "test": "npm run godot:test",
    "check": "npm run typecheck && npm run reference:test && npm run test:resources && npm run content:check && npm run art:verify && npm run audio:check && npm run reference:test:route && npm run reference:test:battle-route && npm run godot:verify && npm run godot:import && npm run godot:test",
    "typecheck": "node tools/run.mjs tsc --noEmit -p config/tsconfig.json",
    "test:resources": "node --test --test-concurrency=1 tests/resources/*.test.mjs && node tools/run.mjs vitest run --config config/vitest.config.ts tests/resources",
    "art:build": "node tools/resources/art.mjs build",
    "art:verify": "node tools/resources/art.mjs verify",
    "art:sheet": "node tools/resources/art.mjs sheet",
    "content:check": "node --experimental-strip-types tools/qa/content-check.ts",
    "audio:check": "node --experimental-strip-types tools/resources/audio-check.ts",
    "reference:dev": "node tools/run.mjs vite --config config/vite.config.ts --host 127.0.0.1",
    "reference:build": "npm run typecheck && node tools/run.mjs vite build --config config/vite.config.ts",
    "reference:preview": "node tools/run.mjs vite preview --config config/vite.config.ts --host 127.0.0.1",
    "reference:test": "node tools/run.mjs vitest run --config config/vitest.config.ts tests/reference",
    "reference:test:web": "node tools/run.mjs playwright test --config config/playwright.config.ts",
    "reference:test:route": "node --experimental-strip-types tools/qa/playthrough.ts",
    "reference:test:battle-route": "node --experimental-strip-types tools/qa/battle-playthrough.ts",
    "godot:sync": "node tools/resources/sync-godot-assets.mjs",
    "godot:verify": "node tools/resources/sync-godot-assets.mjs --verify",
    "godot:import": "node tools/godot/cli.mjs import",
    "godot:test": "node tools/godot/cli.mjs test",
    "godot:export:web": "npm run godot:verify && node tools/godot/cli.mjs export",
    "godot:serve": "node tools/godot/serve.mjs",
    "godot:run": "node tools/godot/cli.mjs run",
    "godot:editor": "node tools/godot/cli.mjs editor",
    "godot:test:web": "node tools/run.mjs playwright test --config config/godot-web.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
